# Night Ops Scheduler — web app (Vite) build-time configuration.
# Copy to .env.local if you need to change it. Values are embedded in the built JS, so never put secrets here.

# Base URL of the API, without /api and without a trailing slash.
# Leave EMPTY when the API serves the app or is reachable on the same origin under /api (recommended).
# Example for a separately hosted API:  VITE_API_URL=https://api.your-domain.com
VITE_API_URL=

# Development only: where Vite's dev server forwards /api requests.
API_PROXY_TARGET=http://localhost:4000
