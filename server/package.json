{
  "name": "night-ops-scheduler-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node src/index.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:local": "node scripts/local-db.js",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "start:prod": "prisma migrate deploy && node src/index.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "nodemailer": "10.5.0",
    "prisma": "6.19.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "embedded-postgres": "17.11.0-beta.19",
    "supertest": "7.3.2",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@embedded-postgres/windows-x64@17.11.0-beta.19": true
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
