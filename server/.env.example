# ─────────────────────────────────────────────────────────────────────────────
# Night Ops Scheduler — API server configuration
# Copy to server/.env for local development. In production, set these in your
# host's environment settings (never commit real values).
# ─────────────────────────────────────────────────────────────────────────────

# development | production
NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Leave EMPTY in local development to use the
# built-in local database (server/.local-db, started automatically by `npm run dev`).
# Production example (managed Postgres, TLS):
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require
DATABASE_URL=

# Public URL of the web app (no trailing slash). Used in password-reset and
# invitation links, and allowed as a CORS origin. REQUIRED in production.
APP_URL=http://localhost:5173

# Extra browser origins allowed to call the API with cookies, comma-separated.
# Only needed when the frontend is hosted on a different origin than the API.
CORS_ORIGINS=

# Serve the built React app (../dist) from this server — single-origin deployment.
SERVE_CLIENT=false

# Number of reverse proxies in front of the app (Render/Railway/Fly/Heroku: 1).
# Needed for correct client IPs (rate limiting) and https detection.
TRUST_PROXY=0

# Session cookie. Defaults: Secure in production, SameSite=lax, 30-day sliding expiry.
# Cross-site deployments (frontend and API on different sites) need SameSite=none + Secure.
COOKIE_SECURE=
COOKIE_SAMESITE=lax
SESSION_DAYS=30

# Password-reset link lifetime in minutes.
RESET_TOKEN_MINUTES=60

# Email (password reset + invitations). Without SMTP_HOST:
#   development → emails are printed in the server terminal
#   production  → email features are reported as unavailable in the UI
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Night Ops Scheduler <no-reply@your-domain.com>"

# Optional tuning (requests per 15 minutes per IP)
RATE_LIMIT_AUTH=30
RATE_LIMIT_API=5000
